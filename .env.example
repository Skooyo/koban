# Google AI Studio API key — get one at https://aistudio.google.com/apikey
# Copy this file to .env and fill in values, then rebuild the app.
GEMINI_API_KEY=

# Optional model overrides (defaults cycle between these on rate limits)
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
GEMINI_MODEL_SECONDARY=gemini-3.5-flash-lite
