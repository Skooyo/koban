import 'schema.drift';

-- Copies of the Room @Query text of SplitDao and two queries of ExpenseDao.
-- observeX and getX with the same text share one query.

bills:
SELECT * FROM split_bills WHERE manual = 0 ORDER BY billTime DESC;

bill:
SELECT * FROM split_bills WHERE id = :billId;

billByLinkedExpense:
SELECT * FROM split_bills WHERE linkedExpenseId = :expenseId LIMIT 1;

items:
SELECT * FROM split_items WHERE billId = :billId ORDER BY position;

shares:
SELECT s.* FROM split_item_shares s
JOIN split_items i ON i.id = s.itemId
WHERE i.billId = :billId;

debts:
SELECT * FROM split_debts WHERE billId = :billId;

debtsByRepayment:
SELECT * FROM split_debts WHERE repaymentExpenseId = :expenseId;

debt:
SELECT * FROM split_debts WHERE id = :debtId;

openDebtRows:
SELECT d.id AS debtId, d.billId AS billId, d.personId AS personId,
       p.name AS personName, b.merchant AS merchant, b.billTime AS billTime,
       d.amount AS amount, b.manual AS manual
FROM split_debts d
JOIN split_people p ON p.id = d.personId
JOIN split_bills b ON b.id = d.billId
WHERE d.status = 'OPEN'
ORDER BY b.billTime ASC;

openDebts:
SELECT * FROM split_debts WHERE status = 'OPEN';

people:
SELECT * FROM split_people WHERE archived = 0 ORDER BY lastUsedAt DESC;

allPeopleIncludingArchived:
SELECT * FROM split_people;

allPeople:
SELECT * FROM split_people WHERE archived = 0 ORDER BY name COLLATE NOCASE;

person:
SELECT * FROM split_people WHERE id = :id;

openDebtsFor:
SELECT * FROM split_debts WHERE status = 'OPEN' AND personId = :personId;

deleteOwedItem:
DELETE FROM owed_items WHERE id = :id;

owedItem:
SELECT * FROM owed_items WHERE id = :id;

owedItemsOf:
SELECT * FROM owed_items WHERE personId = :personId AND status = 'OPEN' ORDER BY itemDate;

openOwedItems:
SELECT * FROM owed_items WHERE personId = :personId AND status = 'OPEN';

allOpenOwedItems:
SELECT * FROM owed_items WHERE status = 'OPEN';

deletePaidOwedItems:
DELETE FROM owed_items WHERE personId = :personId AND status = 'PAID';

deleteSharesByBill:
DELETE FROM split_item_shares WHERE itemId IN (SELECT id FROM split_items WHERE billId = :billId);

deleteItemsByBill:
DELETE FROM split_items WHERE billId = :billId;

deleteDebtsByBill:
DELETE FROM split_debts WHERE billId = :billId;

deleteBill:
DELETE FROM split_bills WHERE id = :billId;

-- ExpenseDao.getRecentByType: active rows of one type since :since that no split has adjusted yet, newest first.
recentByType:
SELECT * FROM expenses
WHERE status != 'DISMISSED' AND transactionType = :type
AND countedAmount IS NULL AND notificationPostTime >= :since
ORDER BY notificationPostTime DESC;

-- ExpenseDao.getById
expenseById:
SELECT * FROM expenses WHERE id = :id;
